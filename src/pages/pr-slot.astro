---
import MainLayout from '../layouts/MainLayout.astro';
const SLOT_URL = import.meta.env.PUBLIC_SLOT_URL || 'http://localhost:3001';
---

<MainLayout
  title="PR Slot — Réservez votre créneau à l'entrepôt"
  description="Réservez en ligne votre créneau de chargement ou déchargement à l'entrepôt PR Logistics (Rogerville & Sandouville). Simple, rapide, sans compte."
  canonicalPath="/pr-slot"
>
  <section class="prslot-hero">
    <div class="container prslot-hero__inner">
      <div class="prslot-badge">Nouveau</div>
      <h1 class="prslot-hero__title">
        Réservez votre créneau<br/>
        <span class="prslot-accent">en ligne</span>
      </h1>
      <p class="prslot-hero__sub">
        PR Slot est notre plateforme de prise de rendez-vous pour les passages à l'entrepôt.
        Chauffeurs et transporteurs : réservez votre créneau de chargement ou de déchargement
        en quelques clics, à tout moment.
      </p>
      <div class="prslot-hero__cta">
        <a href={`${SLOT_URL}/reserver`} class="btn-primary" target="_blank" rel="noopener">
          Prendre un rendez-vous
        </a>
        <a href={`${SLOT_URL}/mes-rdv`} class="btn-secondary" target="_blank" rel="noopener">
          Retrouver mes rendez-vous
        </a>
      </div>
    </div>
  </section>

  <!-- Comment ça marche -->
  <section class="prslot-steps">
    <div class="container">
      <p class="prslot-eyebrow">Simple et rapide</p>
      <h2 class="prslot-section-title">Comment <span class="prslot-accent">ça marche ?</span></h2>
      <div class="prslot-steps__grid">
        <div class="prslot-step">
          <div class="prslot-step__num">01</div>
          <h3>Choisissez votre site et votre opération</h3>
          <p>Rogerville ou Sandouville · Chargement ou déchargement · Palettes ou vrac</p>
        </div>
        <div class="prslot-step">
          <div class="prslot-step__num">02</div>
          <h3>Sélectionnez votre créneau</h3>
          <p>Visualisez les créneaux disponibles en temps réel et choisissez celui qui vous convient</p>
        </div>
        <div class="prslot-step">
          <div class="prslot-step__num">03</div>
          <h3>Confirmez et recevez votre QR code</h3>
          <p>Vous recevez un email de confirmation avec un QR code à présenter à l'entrée de l'entrepôt</p>
        </div>
        <div class="prslot-step">
          <div class="prslot-step__num">04</div>
          <h3>Présentez-vous à l'heure</h3>
          <p>Scannez votre QR code à la borne d'entrée ou signalez votre arrivée depuis votre téléphone</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Avantages -->
  <section class="prslot-avantages">
    <div class="container">
      <p class="prslot-eyebrow">Pourquoi PR Slot ?</p>
      <h2 class="prslot-section-title">Une gestion des <span class="prslot-accent">flux optimisée</span></h2>
      <div class="prslot-avantages__grid">
        <div class="prslot-avantage">
          <div class="prslot-avantage__icon">🕐</div>
          <h3>Disponible 24h/24</h3>
          <p>Réservez à n'importe quelle heure, depuis votre téléphone ou ordinateur</p>
        </div>
        <div class="prslot-avantage">
          <div class="prslot-avantage__icon">📍</div>
          <h3>Deux sites</h3>
          <p>Rogerville et Sandouville — choisissez le site adapté à votre livraison</p>
        </div>
        <div class="prslot-avantage">
          <div class="prslot-avantage__icon">📧</div>
          <h3>Confirmation immédiate</h3>
          <p>Email de confirmation avec QR code dès validation par nos équipes</p>
        </div>
        <div class="prslot-avantage">
          <div class="prslot-avantage__icon">🔄</div>
          <h3>Modification facile</h3>
          <p>Annulez ou retrouvez vos réservations depuis votre email de confirmation</p>
        </div>
        <div class="prslot-avantage">
          <div class="prslot-avantage__icon">📦</div>
          <h3>Palettes ou vrac</h3>
          <p>Durée de créneau calculée automatiquement selon votre volume</p>
        </div>
        <div class="prslot-avantage">
          <div class="prslot-avantage__icon">✅</div>
          <h3>Sans compte</h3>
          <p>Pas besoin de créer un compte — réservation en quelques minutes</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="prslot-cta">
    <div class="container prslot-cta__inner">
      <h2 class="prslot-cta__title">Prêt à réserver votre passage ?</h2>
      <p class="prslot-cta__sub">Accédez à PR Slot et choisissez votre créneau en moins de 2 minutes.</p>
      <div class="prslot-hero__cta">
        <a href={`${SLOT_URL}/reserver`} class="btn-primary" target="_blank" rel="noopener">
          Réserver maintenant
        </a>
        <a href={`${SLOT_URL}/mes-rdv`} class="btn-secondary" target="_blank" rel="noopener">
          Mes rendez-vous existants
        </a>
      </div>
      <p class="prslot-cta__note">Une question ? Contactez-nous au <strong>02 XX XX XX XX</strong> ou à <strong>lehavre@pr-logistics.fr</strong></p>
    </div>
  </section>
</MainLayout>

<style>
  /* ── Variables ── */
  :root {
    --rouge: #e30613;
    --rouge-hover: #c0040f;
    --marine: #1b2a4a;
    --gris-fonce: #1d1d1f;
    --gris-moyen: #86868b;
    --gris-clair: #f5f5f7;
  }

  /* ── Helpers ── */
  .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }

  .prslot-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rouge);
    margin-bottom: 0.75rem;
  }

  .prslot-section-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--gris-fonce);
    margin-bottom: 3rem;
    line-height: 1.2;
  }

  .prslot-accent { color: var(--rouge); }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 2rem;
    background: var(--rouge);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 2rem;
    text-decoration: none;
    transition: background 0.2s, box-shadow 0.2s, transform 0.15s;
  }
  .btn-primary:hover {
    background: var(--rouge-hover);
    box-shadow: 0 6px 20px rgba(227,6,19,0.3);
    transform: translateY(-2px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 2rem;
    background: #fff;
    color: var(--gris-fonce);
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 2rem;
    border: 1.5px solid #e5e7eb;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .btn-secondary:hover {
    border-color: var(--rouge);
    background: #fff0f0;
    color: var(--rouge);
  }

  /* ── Hero ── */
  .prslot-hero {
    background: linear-gradient(160deg, #fff 60%, #fff0f0 100%);
    padding: 5rem 0 4rem;
    text-align: center;
  }

  .prslot-badge {
    display: inline-block;
    background: var(--rouge);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.9rem;
    border-radius: 2rem;
    margin-bottom: 1.5rem;
  }

  .prslot-hero__title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    color: var(--marine);
    line-height: 1.15;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .prslot-hero__sub {
    font-size: 1.05rem;
    color: var(--gris-moyen);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.65;
  }

  .prslot-hero__cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Steps ── */
  .prslot-steps {
    padding: 5rem 0;
    background: #fff;
  }

  .prslot-steps__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }

  .prslot-step {
    background: var(--gris-clair);
    border-radius: 1.25rem;
    padding: 2rem 1.75rem;
  }

  .prslot-step__num {
    font-size: 2rem;
    font-weight: 900;
    color: var(--rouge);
    margin-bottom: 1rem;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  .prslot-step h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--marine);
    margin-bottom: 0.5rem;
  }

  .prslot-step p {
    font-size: 0.9rem;
    color: var(--gris-moyen);
    line-height: 1.5;
  }

  /* ── Avantages ── */
  .prslot-avantages {
    padding: 5rem 0;
    background: var(--gris-clair);
  }

  .prslot-avantages__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .prslot-avantage {
    background: #fff;
    border-radius: 1.25rem;
    padding: 1.75rem;
    border: 1px solid #e5e7eb;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .prslot-avantage:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    transform: translateY(-3px);
  }

  .prslot-avantage__icon {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .prslot-avantage h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--marine);
    margin-bottom: 0.4rem;
  }

  .prslot-avantage p {
    font-size: 0.85rem;
    color: var(--gris-moyen);
    line-height: 1.5;
  }

  /* ── CTA ── */
  .prslot-cta {
    padding: 5rem 0;
    background: var(--marine);
    text-align: center;
  }

  .prslot-cta__title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  .prslot-cta__sub {
    font-size: 1rem;
    color: rgba(255,255,255,0.6);
    margin-bottom: 2rem;
  }

  .prslot-cta .btn-secondary {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.25);
    color: rgba(255,255,255,0.85);
  }

  .prslot-cta .btn-secondary:hover {
    background: rgba(255,255,255,0.18);
    border-color: rgba(255,255,255,0.5);
    color: #fff;
  }

  .prslot-cta__note {
    margin-top: 2rem;
    font-size: 0.85rem;
    color: rgba(255,255,255,0.4);
  }
</style>
