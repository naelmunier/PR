---
import MainLayout from '../layouts/MainLayout.astro';
import PartenairesCarousel from '../components/PartenairesCarousel.astro';
import SecuriteOrbit from '../components/SecuriteOrbit.tsx';
import CircularGallery from '../components/CircularGallery.tsx';

const prestations = [
  { icone: '/assets/nos prestations/depotage-empotage.png', titre: 'Dépotage & Empotage',      desc: 'Déchargement et chargement de conteneurs et de camions avec rigueur et réactivité.',       key: 'depotage' },
  { icone: '/assets/nos prestations/cross-docking.png',     titre: 'Cross Docking',             desc: 'Transfert direct de marchandises sans stockage intermédiaire pour optimiser vos flux.',     key: 'crossdocking' },
  { icone: '/assets/nos prestations/trier.png',             titre: 'Triage',                    desc: 'Tri rigoureux de vos marchandises selon vos critères de classification.',                   key: 'triage' },
  { icone: '/assets/nos prestations/qualite.png',           titre: 'Contrôle Qualité',          desc: 'Contrôles quantitatifs et qualitatifs (aspect extérieur) à réception de vos marchandises.', key: 'qualite' },
  { icone: '/assets/nos prestations/palette.png',           titre: 'Palettisation',             desc: 'Mise sur palettes selon vos spécifications pour une manutention optimale.',                key: 'palettisation' },
  { icone: '/assets/nos prestations/film-plastique.png',    titre: 'Filmage & Cerclage',        desc: 'Sécurisation de vos palettes par filmage et cerclage pour un transport en toute sécurité.', key: 'filmage' },
  { icone: '/assets/nos prestations/preparation-de-commande.png', titre: 'Préparation de commande', desc: 'Picking précis et préparation de commandes adaptés à vos besoins logistiques.',       key: 'preparation' },
  { icone: '/assets/nos prestations/reconditionnemenent.png', titre: 'Reconditionnement',       desc: 'Remise en état et reconditionnement de vos produits selon vos exigences.',                 key: 'reconditionnement' },
  { icone: '/assets/nos prestations/transport-de-livraison.png', titre: 'Transport',            desc: 'Fret conventionnel et traction conteneur depuis et vers le port du Havre.',                key: 'transport' },
];

const equipements = [
  { ico: '/assets/carousel-equipement/entrepots.png',         val: '32 000 m²', label: 'Entrepôt sous douane',         key: 'entrepot' },
  { ico: '/assets/carousel-equipement/pallet.png',            val: '8 000',    label: 'Palettes de stockage',         key: 'palettes' },
  { ico: '/assets/carousel-equipement/banderoleuse.png',      val: '5',        label: 'Banderoleuses / cellule 6 000 m²', key: 'banderoleuses' },
  { ico: '/assets/carousel-equipement/chaine-de-tri.png',     val: '1',        label: 'Chaîne de tri',                key: 'chaine' },
  { ico: '/assets/carousel-equipement/chariot-elevateur.png', val: '14',       label: 'Chariots élévateurs 1,6T – 5T', key: 'chariots' },
  { ico: '/assets/carousel-equipement/videosurveillance.png', val: '36',       label: 'Caméras sécurité 24/7',        key: 'cameras' },
  { ico: '/assets/carousel-equipement/wms.png',               val: '1',        label: 'WMS gestion des stocks',       key: 'wms' },
  { ico: '/assets/carousel-equipement/tracteur-de-parc.png',  val: '2',        label: 'Tracteurs de parc',            key: 'tracteur' },
  { ico: '/assets/carousel-equipement/equipe.png',           val: '20',       label: 'Collaborateurs',               key: 'collaborateurs' },
  { ico: '/assets/carousel-equipement/quais.png',            val: '51',       label: 'Quais de chargement',          key: 'quais' },
];
const col1 = equipements.slice(0, 4);
const col2 = equipements.slice(4, 7);
const col3 = equipements.slice(7);
---

<MainLayout
  title="PR Logistics – Entrepôt Logistique & Transport, Le Havre"
  rawTitle={true}
  description="PR Logistics — entrepôt logistique Le Havre, Normandie. Dépotage, empotage, cross-docking, stockage sous douane, traction portuaire. Sites : Rogerville & Sandouville. Devis gratuit 24h."
>

  <!-- ANNONCE OUVERTURE SANDOUVILLE -->
  <div class="annonce-wrap">
    <a href="#entrepots" class="annonce-pill" id="annoncePill">
      <span class="annonce-badge" data-i18n="annonce.badge">Nouveau</span>
      <span class="annonce-text" data-i18n="annonce.text">Nouvel entrepôt à Sandouville — découvrez le</span>
      <span class="annonce-arrow">→</span>
    </a>
  </div>

  <!-- CARROUSEL PARTENAIRES — juste sous la navbar -->
  <PartenairesCarousel />

  <!-- HERO -->
  <section class="hero">
    <div class="hero__bg-photo" aria-hidden="true"></div>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container hero__inner animate-in">
      <p class="hero__eyebrow" data-i18n="hero.eyebrow">Depuis 2017 · Le Havre</p>
      <h1 class="hero__titre" data-i18n-html="hero.title">Votre partenaire <span>logistique</span><br />au cœur du port du Havre</h1>
      <p class="hero__desc" data-i18n-html="hero.desc">
        PR Logistics est un prestataire indépendant spécialisé dans la <span class="hero__desc-rouge">logistique portuaire</span> et le <span class="hero__desc-rouge">transport</span>.
        Entrepôt sous douane de <span class="hero__desc-rouge">8 000 m²</span>, solutions sur mesure, réactivité garantie.
      </p>
      <div class="hero__ctas">
        <a href="/contact" class="btn btn--rouge" data-i18n="hero.cta.contact">Nous contacter</a>
        <a href="/devis" class="btn btn--outline hero__btn-outline" data-i18n="hero.cta.devis">Demander un devis</a>
      </div>
    </div>
    <div class="hero__scroll" aria-hidden="true">
      <div class="hero__scroll-line"></div>
    </div>
  </section>

  <!-- PRESTATIONS -->
  <section class="section section--gris prestations-section">
    <div class="container">
      <div class="reveal" style="text-align:center; margin-bottom: 3.5rem;">
        <p class="eyebrow-rouge" data-i18n="prestations.eyebrow">Ce que nous faisons</p>
        <h2 class="titre-section" data-i18n-html="prestations.title">Nos <span>prestations</span></h2>
        <p class="sous-titre" style="margin: 1rem auto 0;" data-i18n="prestations.subtitle">
          Une gamme complète de services logistiques adaptée aux exigences du commerce international.
        </p>
      </div>
      <CircularGallery
        client:load
        items={prestations.map(p => ({ image: p.icone, text: p.titre, desc: p.desc }))}
        bend={2.8}
        scrollEase={0.06}
      />
    </div>
  </section>

  <!-- NOS MOYENS -->
  <section class="section moyens" id="entrepots">
    <div class="container">
      <div class="reveal" style="text-align:center; margin-bottom:3.5rem;">
        <p class="eyebrow-rouge" data-i18n="moyens.eyebrow">Nos équipements</p>
        <h2 class="titre-section" data-i18n-html="moyens.title">Des moyens à la <span>hauteur</span></h2>
      </div>

      <!-- ── Hover Reveal Cards — deux sites ── -->
      <div class="hrc-grid">

        <!-- Sandouville -->
        <div class="hrc-card reveal" data-site="sandouville" style="transition-delay:0.05s;" role="button" tabindex="0" aria-label="Voir les détails du site de Sandouville">
          <!-- Données i18n cachées — lues par le drawer JS après traduction -->
          <span class="hrc-data" data-key="titre"   data-i18n-html="entrepot.sandouville.titre"   hidden>Site de <span class="entrepot-rouge">Sandouville</span></span>
          <span class="hrc-data" data-key="desc"    data-i18n="entrepot.sandouville.desc"          hidden>Nouveau site logistique d'envergure nationale, à deux pas du port du Havre.</span>
          <span class="hrc-data" data-key="addr"    data-i18n="entrepot.sandouville.adresse"       hidden>Port 5052, Voie des Tadornes, 76430 Sandouville</span>
          <span class="hrc-data" data-key="surface" data-i18n="entrepot.sandouville.surface"       hidden>24 000 m² de surface</span>
          <span class="hrc-data" data-key="quais"   data-i18n="entrepot.sandouville.quais"         hidden>44 quais et 2 portes sectionnelles</span>
          <span class="hrc-data" data-key="mapurl"  hidden>https://maps.google.com/?q=Port+5052+Voie+des+Tadornes+76430+Sandouville</span>

          <img class="hrc-card__img" src="/assets/entrepot/nouvel-entrepot2.jpg" alt="Futur entrepôt de Sandouville" loading="lazy" />

          <div class="hrc-card__overlay">
            <div class="hrc-card__badge hrc-card__badge--soon">
              <span class="badge-dot" aria-hidden="true"></span>
              <span data-i18n="entrepot.soon">Ouverture imminente</span>
            </div>
            <div class="hrc-card__reveal-panel">
              <p class="hrc-card__sub">Sandouville · 24 000 m²</p>
              <div class="hrc-card__bottom">
                <h3 class="hrc-card__title">Sandouville</h3>
                <span class="hrc-card__cta">
                  Voir les détails
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Rogerville -->
        <div class="hrc-card reveal" data-site="rogerville" style="transition-delay:0.15s;" role="button" tabindex="0" aria-label="Voir les détails du site de Rogerville">
          <!-- Données i18n cachées -->
          <span class="hrc-data" data-key="titre"   data-i18n-html="entrepot.rogerville.titre"     hidden>Site de <span class="entrepot-rouge">Rogerville</span></span>
          <span class="hrc-data" data-key="desc"    data-i18n="entrepot.rogerville.desc"            hidden>Notre entrepôt actuel, entièrement clos et télésurveillé 24h/7j par la sécurité portuaire.</span>
          <span class="hrc-data" data-key="addr"    data-i18n="entrepot.rogerville.adresse"         hidden>PLPN 1 – Port 4935, 76700 Rogerville</span>
          <span class="hrc-data" data-key="surface" data-i18n="entrepot.rogerville.surface"         hidden>8 000 m² de surface</span>
          <span class="hrc-data" data-key="quais"   data-i18n="entrepot.rogerville.quais"           hidden>6 quais de chargement</span>
          <span class="hrc-data" data-key="mapurl"  hidden>https://maps.google.com/?q=PLPN+1+Port+4935+76700+Rogerville</span>

          <img class="hrc-card__img" src="/assets/entrepot/ancien-entrepot.jpg" alt="Entrepôt de Rogerville" loading="lazy" />

          <div class="hrc-card__overlay">
            <div class="hrc-card__badge hrc-card__badge--actif" data-i18n="entrepot.actif">Site actuel</div>
            <div class="hrc-card__reveal-panel">
              <p class="hrc-card__sub">Rogerville · 8 000 m²</p>
              <div class="hrc-card__bottom">
                <h3 class="hrc-card__title">Rogerville</h3>
                <span class="hrc-card__cta">
                  Voir les détails
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Modale carte détails site -->
      <div class="site-modal" id="siteModal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Détails du site">
        <div class="site-modal__backdrop" id="siteModalBackdrop"></div>
        <div class="site-modal__wrap">
          <div class="site-modal__card">

            <!-- Header -->
            <div class="site-modal__header">
              <div class="site-modal__header-left">
                <div class="site-modal__ico-wrap" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </div>
                <h2 class="site-modal__title" id="siteModalTitle">Site</h2>
              </div>
              <button class="site-modal__close" id="siteModalClose" aria-label="Fermer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>

            <!-- Body -->
            <div class="site-modal__body" id="siteModalBody"></div>

          </div>
        </div>
      </div>

      <!-- ── Sécurité ── -->
      <div class="securite-bloc reveal">
        <div class="securite-header">
          <span class="securite-eyebrow" data-i18n="securite.eyebrow">Sécurité</span>
          <h3 class="securite-titre" data-i18n-html="securite.title">Votre marchandise, sous <span class="securite-accent">haute surveillance</span></h3>
          <p class="securite-sous-titre" data-i18n="securite.subtitle">La sécurité n'est pas une option — c'est notre engagement premier. Chaque site est conçu pour protéger vos flux, nuit et jour, 365 jours par an.</p>
        </div>
        <SecuriteOrbit client:load />
      </div>

      <!-- ── Bridge / Statement ── -->
      <div class="entrepots-bridge reveal">
        <p class="bridge-eyebrow" data-i18n="entrepot.bridge.eyebrow">Dès maintenant</p>
        <h3 class="bridge-title" data-i18n-html="entrepot.bridge.title">
          Deux sites au service de votre <span class="bridge-grad">performance</span><br class="bridge-br">
          et de la <span class="bridge-grad">fiabilité</span> de chaque flux.
        </h3>
        <div class="bridge-stats-row">
          <div class="bridge-kpi">
            <span class="bridge-kpi__val" data-count="32000" data-suffix="">32 000</span>
            <span class="bridge-kpi__unit">m²</span>
            <span class="bridge-kpi__lbl" data-i18n="entrepot.kpi.surface">de surface totale</span>
          </div>
          <div class="bridge-kpi">
            <span class="bridge-kpi__val" data-count="51" data-suffix="">51</span>
            <span class="bridge-kpi__unit" data-i18n="entrepot.kpi.quais.unit">quais</span>
            <span class="bridge-kpi__lbl" data-i18n="entrepot.kpi.quais">de chargement</span>
          </div>
          <div class="bridge-kpi">
            <span class="bridge-kpi__val" data-count="2" data-suffix="">2</span>
            <span class="bridge-kpi__unit" data-i18n="entrepot.kpi.sites.unit">sites</span>
            <span class="bridge-kpi__lbl" data-i18n="entrepot.kpi.sites">logistiques stratégiques</span>
          </div>
        </div>
      </div>

      <!-- Colonnes d'équipements — défilement vertical infini -->
      <div class="equip-columns reveal">

        <!-- Colonne 1 -->
        <div class="equip-col">
          <div class="equip-col__inner equip-col__inner--1">
            {[...col1, ...col1].map((e) => (
              <div class="equip-card">
                <img class="equip-card__ico" src={e.ico} alt={e.label} width="48" height="48" loading="lazy" />
                <span class="equip-card__val">{e.val}</span>
                <span class="equip-card__label" data-i18n={`equip.${e.key}`}>{e.label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Colonne 2 — masquée mobile -->
        <div class="equip-col equip-col--md">
          <div class="equip-col__inner equip-col__inner--2">
            {[...col2, ...col2].map((e) => (
              <div class="equip-card">
                <img class="equip-card__ico" src={e.ico} alt={e.label} width="48" height="48" loading="lazy" />
                <span class="equip-card__val">{e.val}</span>
                <span class="equip-card__label" data-i18n={`equip.${e.key}`}>{e.label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Colonne 3 — masquée mobile/tablet -->
        <div class="equip-col equip-col--lg">
          <div class="equip-col__inner equip-col__inner--3">
            {[...col3, ...col3].map((e) => (
              <div class="equip-card">
                <img class="equip-card__ico" src={e.ico} alt={e.label} width="48" height="48" loading="lazy" />
                <span class="equip-card__val">{e.val}</span>
                <span class="equip-card__label" data-i18n={`equip.${e.key}`}>{e.label}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section cta-section">
    <div class="cta-blob cta-blob--1" aria-hidden="true"></div>
    <div class="cta-blob cta-blob--2" aria-hidden="true"></div>
    <div class="container" style="position:relative;">
      <div class="cta-bloc reveal">
        <h2 class="titre-section" data-i18n-html="cta.title">Prêt à optimiser votre <span>logistique</span> ?</h2>
        <p style="color:var(--gris-moyen); max-width:520px; margin: 1.2rem auto 0; font-size:1.1rem;" data-i18n="cta.subtitle">
          Contactez-nous dès aujourd'hui pour étudier ensemble vos besoins logistiques.
        </p>
        <div style="display:flex; gap:1rem; justify-content:center; margin-top:2.5rem; flex-wrap:wrap;">
          <a href="/contact" class="btn btn--rouge" data-i18n="cta.contact">Nous contacter</a>
          <a href="/devis" class="btn btn--outline" data-i18n="cta.devis">Demander un devis</a>
        </div>
      </div>
    </div>
  </section>

</MainLayout>

<script>
  /* ── Count-up animation pour les KPIs ── */
  function animateCount(el: HTMLElement) {
    const target = parseInt(el.dataset.count || '0', 10);
    const suffix = el.dataset.suffix || '';
    const duration = 2800;
    const start = performance.now();
    const ease = (t: number) => t < 0.5 ? 2*t*t : -1+(4-2*t)*t;
    function step(now: number) {
      const elapsed = Math.min((now - start) / duration, 1);
      const val = Math.round(ease(elapsed) * target);
      el.textContent = val.toLocaleString('fr-FR') + suffix;
      if (elapsed < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  const kpiObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.querySelectorAll<HTMLElement>('[data-count]').forEach(el => animateCount(el));
        kpiObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.4 });

  document.querySelectorAll('.bridge-stats-row').forEach(el => kpiObserver.observe(el));


  /* ── Modale carte — détails des sites ── */
  (() => {
    const modal    = document.getElementById('siteModal');
    const backdrop = document.getElementById('siteModalBackdrop');
    const closeBtn = document.getElementById('siteModalClose');
    const titleEl  = document.getElementById('siteModalTitle');
    const bodyEl   = document.getElementById('siteModalBody');
    if (!modal || !bodyEl || !titleEl) return;

    function openModal(cardEl: HTMLElement) {
      /* Lecture i18n depuis les spans cachés */
      const d: Record<string, string> = {};
      cardEl.querySelectorAll<HTMLElement>('.hrc-data[data-key]').forEach(span => {
        d[span.dataset.key!] = span.innerHTML;
      });

      /* Titre dans le header */
      titleEl.innerHTML = d.titre ?? '';

      /* Surface → extraire jusqu'à m² */
      const surfRaw = d.surface ?? '';
      const mIdx    = surfRaw.indexOf('m²');
      const surfNum = mIdx >= 0 ? surfRaw.slice(0, mIdx + 2).trim() : surfRaw;

      /* Map URL */
      const mapUrl = cardEl.querySelector<HTMLElement>('.hrc-data[data-key="mapurl"]')?.textContent?.trim() ?? '#';

      /* SVG icons */
      const surfIco = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>`;
      const quaiIco = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><line x1="8" y1="4" x2="8" y2="20"/><line x1="16" y1="4" x2="16" y2="20"/></svg>`;
      const mapIco  = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`;

      bodyEl.innerHTML = `
        <div class="site-modal__rows">
          <div class="site-modal__row">
            <span class="site-modal__row-ico">${surfIco}</span>
            <span class="site-modal__row-label">Surface</span>
            <span class="site-modal__row-sep">:</span>
            <span class="site-modal__row-val">${surfNum}</span>
          </div>
          <div class="site-modal__row">
            <span class="site-modal__row-ico">${quaiIco}</span>
            <span class="site-modal__row-label">Quais</span>
            <span class="site-modal__row-sep">:</span>
            <span class="site-modal__row-val">${d.quais ?? ''}</span>
          </div>
          <a class="site-modal__row site-modal__row--map" href="${mapUrl}" target="_blank" rel="noopener noreferrer">
            <span class="site-modal__row-ico">${mapIco}</span>
            <span class="site-modal__row-label">Voir sur la carte</span>
            <span class="site-modal__row-sep">:</span>
            <span class="site-modal__row-val">${d.addr ?? ''}&nbsp;↗</span>
          </a>
        </div>
      `;

      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.querySelectorAll<HTMLElement>('.hrc-card').forEach(card => {
      card.addEventListener('click',   ()  => openModal(card));
      card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(card); } });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.classList.contains('open')) closeModal(); });
  })();
</script>

<style>
  /* ── ANNONCE OUVERTURE ── */
  .annonce-wrap {
    background: white;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    display: flex;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    animation: annonce-slide-in 0.55s cubic-bezier(0.34,1.4,0.64,1) both;
  }
  @keyframes annonce-slide-in {
    from { opacity: 0; transform: translateY(-10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .annonce-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: linear-gradient(135deg, #fff8ec, #fff);
    border: 1.5px solid rgba(245,158,11,0.3);
    border-radius: 2rem;
    padding: 0.42rem 1.1rem 0.42rem 0.65rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #92400e;
    text-decoration: none;
    box-shadow: 0 2px 12px rgba(245,158,11,0.12);
    transition: box-shadow 0.25s, transform 0.25s, border-color 0.25s;
  }
  .annonce-pill:hover {
    box-shadow: 0 5px 24px rgba(245,158,11,0.28);
    transform: translateY(-1px);
    border-color: rgba(245,158,11,0.55);
  }
  .annonce-badge {
    background: linear-gradient(135deg, #f59e0b, #dc6b00);
    color: white;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.18rem 0.6rem;
    border-radius: 2rem;
    flex-shrink: 0;
  }
  .annonce-text {
    line-height: 1;
  }
  .annonce-arrow {
    opacity: 0.55;
    font-size: 0.85rem;
    transition: transform 0.2s, opacity 0.2s;
  }
  .annonce-pill:hover .annonce-arrow {
    transform: translateX(3px);
    opacity: 1;
  }

  /* HERO */
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* Photo de fond */
  .hero__bg-photo {
    position: absolute;
    inset: 0;
    background: url('/assets/home/port-havre-2.jpg') center center / cover no-repeat;
    pointer-events: none;
    animation: hero-dezoom 5s ease-out forwards;
  }

  @keyframes hero-dezoom {
    from {
      transform: scale(1.12);
      filter: blur(1.5px) brightness(0.62);
    }
    to {
      transform: scale(1.04);
      filter: blur(0.8px) brightness(0.62);
    }
  }

  /* Dégradé sombre en bas pour transition douce */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10,10,10,0.1) 0%,
      rgba(10,10,10,0.05) 50%,
      rgba(10,10,10,0.45) 100%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    text-align: center;
    max-width: 860px;
    margin: 0 auto;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .hero__eyebrow {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: rgba(255,255,255,0.75);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1.4rem;
    background: rgba(255,255,255,0.1);
    padding: 0.35rem 1rem;
    border-radius: 2rem;
    backdrop-filter: blur(6px);
  }

  .hero__titre {
    font-size: calc(var(--font-size-hero) * 0.9);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: 1.6rem;
    text-shadow: 0 2px 20px rgba(0,0,0,0.3);
  }

  .hero__titre span {
    color: #ff4d57;
  }

  .hero__desc {
    font-size: 1.25rem;
    color: rgba(255,255,255,0.93);
    max-width: 660px;
    margin: 2.2rem auto 2.8rem;
    line-height: 1.75;
    text-shadow: 0 1px 8px rgba(0,0,0,0.25);
  }

  .hero__desc-rouge {
    color: #ff4d57;
    font-weight: 600;
  }

  .hero__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero__btn-outline {
    border-color: rgba(255,255,255,0.7) !important;
    color: white !important;
  }

  .hero__btn-outline:hover {
    background: rgba(255,255,255,0.15) !important;
    border-color: white !important;
  }

  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    justify-content: center;
  }

  .hero__scroll-line {
    width: 2px;
    height: 40px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.6), transparent);
    border-radius: 2px;
    animation: scroll-down 1.5s ease-in-out infinite;
  }

  @keyframes scroll-down {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  /* QUI SOMMES-NOUS */
  .eyebrow-rouge {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--rouge);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.8rem;
  }

  .qsn__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .qsn__stats {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .qsn__stat-badge {
    background: linear-gradient(135deg, var(--rouge), #b00010);
    border-radius: var(--rayon-lg);
    padding: 2.5rem;
    text-align: center;
    color: white;
  }

  .qsn__annee {
    display: block;
    font-size: 4rem;
    font-weight: 800;
    line-height: 1;
  }

  .qsn__annee-label {
    font-size: 0.9rem;
    opacity: 0.8;
    margin-top: 0.3rem;
    display: block;
  }

  .qsn__info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .qsn__info-item {
    background: var(--gris-clair);
    border-radius: var(--rayon);
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
  }

  .qsn__info-val {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--gris-fonce);
    line-height: 1;
  }

  .qsn__info-val small {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--rouge);
    margin-left: 3px;
  }

  .qsn__info-label {
    font-size: 0.75rem;
    color: var(--gris-moyen);
    margin-top: 0.3rem;
  }

  /* PRESTATIONS */
  .prestations-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .prestation-carte {
    background: white;
    border-radius: var(--rayon-lg);
    overflow: hidden;
    padding: 2rem;
    box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    transition:
      transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      box-shadow 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    cursor: default;
  }

  .prestation-carte:hover {
    transform: translateY(-10px) scale(1.03);
    box-shadow: 0 20px 50px rgba(0,0,0,0.14);
  }

  .prestation-carte__icone {
    width: 48px;
    height: 48px;
    margin-bottom: 1rem;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .prestation-carte__icone img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 0;
  }

  .prestation-carte:hover .prestation-carte__icone {
    transform: scale(1.2) translateY(-3px);
  }

  .prestation-carte__titre {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--gris-fonce);
    margin-bottom: 0.5rem;
    transition: color 0.3s;
  }

  .prestation-carte:hover .prestation-carte__titre {
    color: var(--rouge);
  }

  .prestation-carte__desc {
    font-size: 0.92rem;
    color: var(--gris-moyen);
    line-height: 1.65;
  }

  /* Barre rouge animée en bas de carte */
  .prestation-carte__accent {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 3px;
    width: 0;
    background: var(--rouge);
    border-radius: 0 0 var(--rayon-lg) var(--rayon-lg);
    transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .prestation-carte:hover .prestation-carte__accent {
    width: 100%;
  }

  /* ══════════════════════════════════════════════════════
     HOVER REVEAL CARDS — deux sites
  ══════════════════════════════════════════════════════ */
  .hrc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .hrc-card {
    position: relative;
    height: 520px;
    border-radius: 2rem;
    overflow: hidden;
    cursor: pointer;
    background: #111;
    box-shadow: 0 4px 32px rgba(0,0,0,0.1);
    transition:
      box-shadow 0.5s ease,
      transform 0.5s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .hrc-card:hover {
    box-shadow: 0 24px 64px rgba(0,0,0,0.22);
    transform: translateY(-6px) scale(1.012);
  }

  .hrc-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    border-radius: 0 !important;
    filter: brightness(0.92) saturate(0.9);
  }
  .hrc-card:hover .hrc-card__img {
    transform: scale(1.06);
    filter: brightness(0.85) saturate(1.05);
  }

  /* Gradient permanent en bas */
  .hrc-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.1) 0%,
      transparent 30%,
      rgba(0,0,0,0.45) 60%,
      rgba(0,0,0,0.82) 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.3rem 1.5rem 1.8rem;
  }

  /* ── Badge ── */
  .hrc-card__badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.28rem 0.9rem;
    border-radius: 2rem;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .hrc-card__badge--soon {
    background: linear-gradient(135deg, #f59e0b, #dc6b00);
    color: white;
    box-shadow: 0 2px 12px rgba(245,158,11,0.4);
    animation: badge-pulse 1.8s ease-in-out infinite;
  }
  .hrc-card__badge--actif {
    background: rgba(255,255,255,0.88);
    color: #e30613;
    border: 1px solid rgba(227,6,19,0.2);
  }
  @keyframes badge-pulse {
    0%, 100% { box-shadow: 0 2px 12px rgba(245,158,11,0.4); }
    50%       { box-shadow: 0 4px 22px rgba(245,158,11,0.75); }
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    flex-shrink: 0;
    display: inline-block;
    align-self: center;
    animation: dot-blink 1.2s ease-in-out infinite;
  }
  @keyframes dot-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.2; }
  }

  .entrepot-rouge { color: var(--rouge); }

  /* ── Reveal panel ── */
  .hrc-card__reveal-panel {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hrc-card__sub {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.72);
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .hrc-card:hover .hrc-card__sub {
    opacity: 1;
    transform: none;
  }

  .hrc-card__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hrc-card__title {
    font-size: clamp(1.8rem, 2.8vw, 2.4rem);
    font-weight: 800;
    color: white;
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0;
    text-shadow: 0 2px 16px rgba(0,0,0,0.35);
  }

  .hrc-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255,255,255,0.6);
    white-space: nowrap;
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.32s ease 0.06s, transform 0.32s ease 0.06s, color 0.2s;
  }
  .hrc-card:hover .hrc-card__cta {
    opacity: 1;
    transform: none;
    color: white;
  }

  @media (max-width: 768px) {
    .hrc-grid {
      grid-template-columns: 1fr;
    }
    .hrc-card {
      height: 380px;
    }
  }

  /* ══════════════════════════════════════════════════════
     MODALE CARTE — détails du site
  ══════════════════════════════════════════════════════ */
  .site-modal {
    position: fixed;
    inset: 0;
    z-index: 9000;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .site-modal.open { pointer-events: all; }

  .site-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.46);
    opacity: 0;
    transition: opacity 0.28s ease;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }
  .site-modal.open .site-modal__backdrop { opacity: 1; }

  .site-modal__wrap {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 420px;
    transform: scale(0.94) translateY(14px);
    opacity: 0;
    transition:
      transform 0.38s cubic-bezier(0.34, 1.4, 0.64, 1),
      opacity   0.28s ease;
  }
  .site-modal.open .site-modal__wrap {
    transform: none;
    opacity: 1;
  }

  .site-modal__card {
    background: white;
    border-radius: 1.8rem;
    box-shadow:
      0 28px 80px rgba(0,0,0,0.16),
      0 4px 20px rgba(0,0,0,0.07);
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.06);
  }

  /* Header */
  .site-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.35rem 1.5rem;
    border-bottom: 1px solid rgba(0,0,0,0.07);
  }
  .site-modal__header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .site-modal__ico-wrap {
    width: 38px;
    height: 38px;
    border-radius: 0.85rem;
    background: rgba(227,6,19,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--rouge);
  }
  .site-modal__title {
    font-size: 1rem;
    font-weight: 700;
    color: #1d1d1f;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .site-modal__title .entrepot-rouge { color: var(--rouge); }

  .site-modal__close {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1.5px solid rgba(0,0,0,0.1);
    background: #f5f5f7;
    color: #6e6e73;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s, color 0.2s;
  }
  .site-modal__close:hover { background: #e8e8ed; color: #1d1d1f; }

  /* Body de la modale */
  .site-modal__body {
    padding: 1.25rem 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Lignes de données */
  .site-modal__rows {
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0,0,0,0.07);
    border-radius: 1rem;
    overflow: hidden;
  }
  .site-modal__row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.88rem 1rem;
    background: white;
    text-decoration: none;
    transition: background 0.16s;
    /* Séparateur entre lignes */
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .site-modal__row:last-child { border-bottom: none; }
  .site-modal__row:hover { background: #fafafa; }
  .site-modal__row-ico {
    width: 32px;
    height: 32px;
    border-radius: 0.6rem;
    background: rgba(227,6,19,0.07);
    color: var(--rouge);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .site-modal__row-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: #3a3a3c;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .site-modal__row-sep {
    font-size: 0.82rem;
    color: #c7c7cc;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .site-modal__row-val {
    font-size: 0.84rem;
    font-weight: 500;
    color: #1d1d1f;
    text-align: right;
    flex: 1;
    line-height: 1.4;
    min-width: 0;
  }
  .site-modal__row--map .site-modal__row-label { color: var(--rouge); }
  .site-modal__row--map .site-modal__row-val   { color: var(--rouge); font-weight: 600; }
  .site-modal__row--map:hover .site-modal__row-val { text-decoration: underline; }


  /* ══════════════════════════════════════════════════════
     SECTION SÉCURITÉ
  ══════════════════════════════════════════════════════ */
  /* ══════════════════════════════════════════════════════
     SECTION SÉCURITÉ — fond clair dans le thème du site
  ══════════════════════════════════════════════════════ */
  .securite-bloc {
    margin-top: 4rem;
    background: linear-gradient(135deg, #ffffff 0%, #fdf5f5 100%);
    border-radius: 2.4rem;
    padding: 3.5rem 3rem;
    border: 1px solid rgba(227,6,19,0.08);
    box-shadow: 0 4px 40px rgba(227,6,19,0.06), 0 1px 8px rgba(0,0,0,0.04);
    overflow: hidden;
    position: relative;
  }
  .securite-bloc::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(227,6,19,0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .securite-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2.5rem;
    position: relative;
  }
  .securite-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rouge);
    background: rgba(227,6,19,0.07);
    border: 1px solid rgba(227,6,19,0.18);
    border-radius: 2rem;
    padding: 0.25rem 0.9rem;
    margin-bottom: 1rem;
  }
  .securite-titre {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.18;
    color: var(--gris-fonce);
    margin: 0 0 0.9rem;
  }
  .securite-sous-titre {
    font-size: 1rem;
    color: var(--gris-moyen);
    line-height: 1.7;
    margin: 0;
  }
  .securite-accent {
    background: linear-gradient(90deg, #e30613 0%, #ff2b2b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .securite-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    position: relative;
  }
  .securite-item {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.07);
    border-radius: 1.4rem;
    padding: 1.8rem 1rem 1.6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.9rem;
    justify-content: flex-start;
    box-shadow: 0 2px 14px rgba(0,0,0,0.04);
    transition: box-shadow 0.3s, border-color 0.3s, transform 0.35s cubic-bezier(0.34,1.4,0.64,1);
  }
  .securite-item:hover {
    box-shadow: 0 12px 40px rgba(227,6,19,0.1);
    border-color: rgba(227,6,19,0.25);
    transform: translateY(-6px);
  }
  .securite-item__ico-wrap {
    background: rgba(227,6,19,0.08);
    border-radius: 0.75rem;
    padding: 0.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .securite-item__ico-wrap img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    display: block;
    mix-blend-mode: multiply;
  }
  .securite-item__ico-wrap img[src*="cloture"] {
    mix-blend-mode: normal;
    width: 52px;
    height: 52px;
  }
  .securite-item__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
  .securite-item__val {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--gris-fonce);
    line-height: 1.25;
  }
